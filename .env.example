# Copy to .env at the repo root. Gitignored.
# Needed only for the chat dock in the spec tool; everything else runs without it.
#
# Pick ONE, and mind which variable it goes in — they are not interchangeable:
#
#   console API key from console.anthropic.com   → sk-ant-api...  → ANTHROPIC_API_KEY
#   subscription token from `claude setup-token` → sk-ant-oat...  → CLAUDE_CODE_OAUTH_TOKEN
#
# An OAuth token in ANTHROPIC_API_KEY loads fine and then fails every call with
# "Invalid API key". The server checks for that on boot and says so.

ANTHROPIC_API_KEY=sk-ant-api...
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat...

# Optional: a voice for the chat dock that is not one the operating system ships.
#
# Without it, replies are read aloud by the browser's own synthesiser and nothing leaves the
# machine. With it, the sentence being spoken is sent to ElevenLabs — through the server, which
# holds the key, so the browser never sees it. The local voice stays the fallback for a spent
# quota, a rate limit or an unreachable host, so setting this can only add.
#
# ELEVENLABS_API_KEY=sk_...
# ELEVENLABS_MODEL=eleven_turbo_v2_5

# Optional overrides
# SPECS_DIR=/absolute/path/to/specs
# DATA_DIR=/absolute/path/for/transcripts.db
# PORT=5174
